{
  "name": "@honza-kubat/oc-dev",
  "version": "0.1.0",
  "description": "OpenCode plugin with custom skills, agents, and commands",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/",
    "agents/",
    "commands/",
    "skills/"
  ],
  "scripts": {
    "build": "bun build src/index.ts --outdir dist --target bun",
    "dev": "bun run --watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "prepublishOnly": "bun run build"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": ">=0.1.0"
  },
  "dependencies": {
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "latest",
    "typescript": "^5.7.0",
    "@types/bun": "latest"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "ai",
    "coding-agent"
  ],
  "license": "MIT",
  "author": "Honza Kubat"
}
